{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.skill-family.example/v1/fixed-set-generation-resolution.json",
  "title": "Fixed-set generation resolution",
  "description": "One complete read of current.json. Callers reuse this rootBinding for the whole read and do not resolve the pointer again per member.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "kind", "pointer", "generationRoot", "rootBinding"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "kind": { "const": "skill-family.fixed-set-generation-resolution" },
    "pointer": { "$ref": "https://contracts.skill-family.example/v1/fixed-set-generation-pointer.json" },
    "generationRoot": { "type": "string", "minLength": 1 },
    "rootBinding": { "$ref": "https://contracts.skill-family.example/v1/filesystem-root-binding.json" }
  }
}
